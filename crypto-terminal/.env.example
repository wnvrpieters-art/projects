# ---- local proxy ----
API_PORT=8787

# ---- Binance Spot ----
# Global:      https://api.binance.com          wss://stream.binance.com:9443
# US:          https://api.binance.us           wss://stream.binance.us:9443
# Alt (GCP):   https://api-gcp.binance.com
# Pick the host that is actually reachable and legal from your location.
BINANCE_REST=https://api.binance.com
BINANCE_WS=wss://stream.binance.com:9443

# Weight budget the proxy will spend per rolling minute. Binance publishes the
# real ceiling in GET /api/v3/exchangeInfo -> rateLimits. Keep headroom.
BINANCE_WEIGHT_PER_MIN=4800

# ---- Coinbase Exchange (public market data, no auth) ----
COINBASE_REST=https://api.exchange.coinbase.com
COINBASE_WS=wss://ws-feed.exchange.coinbase.com
